# ===================================================
# SVLentes Environment Variables Template
# ===================================================
# INSTRUCTIONS:
# 1. Copy this file to .env.local: cp .env.local.example .env.local
# 2. Replace all placeholder values with your actual credentials
# 3. NEVER commit .env.local to version control
# 4. Keep this template updated when adding new environment variables
# 5. TODO: [OPS] Add quarterly key rotation schedule to calendar
# 6. TODO: [SECURITY] Implement environment variable validation script
# ===================================================

# Application Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=5533999898026
NEXT_PUBLIC_SUPPORT_PHONE=5533986061427

# Firebase Authentication (Client-side)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com

# Firebase Admin SDK (Server-side)
# Get from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"your_project","private_key_id":"your_key_id","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@yourproject.iam.gserviceaccount.com","client_id":"YOUR_CLIENT_ID","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk%40yourproject.iam.gserviceaccount.com","universe_domain":"googleapis.com"}'

# Database Configuration
# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/database_name?schema=public"

# Stripe Payment Integration (Primary - International gateway)
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# WordPress Blog Integration
WORDPRESS_API_URL=https://yourdomain.com/wp-json/wp/v2
NEXT_PUBLIC_WORDPRESS_URL=https://yourdomain.com/wp
REVALIDATE_SECRET=your_revalidate_secret_here

# Airtable Integration (Optional)
# Get token from: https://airtable.com/create/tokens
AIRTABLE_API_KEY=your_airtable_personal_access_token
AIRTABLE_BASE_ID=your_base_id
SUBSCRIPTION_DEMO_MODE=false

# Resend Email Service
# Get key from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
NEXT_PUBLIC_EMAIL_FROM=your_email@yourdomain.com

# WhatsApp & AI Integration
WHATSAPP_VERIFY_TOKEN=your_verify_token_here

# OpenAI API (for AI-powered customer support)
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# LangSmith Configuration (Optional - for AI monitoring)
# Get key from: https://smith.langchain.com/settings
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=your_project_name

# SendPulse WhatsApp Integration
# Get tokens from: https://sendpulse.com/integrations/whatsapp
SENDPULSE_APP_ID=your_sendpulse_app_id
SENDPULSE_APP_SECRET=your_sendpulse_app_secret
SENDPULSE_BOT_ID=your_whatsapp_bot_id

# Legacy aliases for backward compatibility
SENDPULSE_CLIENT_ID=your_sendpulse_app_id
SENDPULSE_CLIENT_SECRET=your_sendpulse_app_secret

# Sanity CMS (if used)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production


# GitHub Authentication (Feature Flag)
NEXT_PUBLIC_ENABLE_GITHUB_AUTH=true

# Clerk Authentication (Alternative/Additional auth provider)
# Get keys from: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Next.js Authentication (if using NextAuth.js)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# Analytics & Monitoring
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Rate Limiting (Optional - uses in-memory if not configured)
# Get credentials from: https://upstash.com
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here