# ----------------------------------------------------------------------------
# Base Application Configuration
# ----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PHASE=local
BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_DEBUG=false

# ----------------------------------------------------------------------------
# Database & Persistence
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://{{DB_USER}}:{{DB_PASSWORD}}@{{DB_HOST}}:{{DB_PORT}}/{{DB_NAME}}"
DATABASE_DIRECT_URL="postgresql://{{DB_USER}}:{{DB_PASSWORD}}@{{DB_HOST}}:{{DB_PORT}}/{{DB_NAME}}"
UPSTASH_REDIS_REST_URL=https://{{UPSTASH_HOST}}
UPSTASH_REDIS_REST_TOKEN={{UPSTASH_TOKEN}}
REDIS_URL=https://{{REDIS_REST_URL}}
REDIS_TOKEN={{REDIS_REST_TOKEN}}

# ----------------------------------------------------------------------------
# Authentication & Sessions
# ----------------------------------------------------------------------------
NEXTAUTH_SECRET={{NEXTAUTH_SECRET}}
JWT_SECRET={{JWT_SECRET}}
ADMIN_JWT_SECRET={{ADMIN_JWT_SECRET}}
ADMIN_JWT_EXPIRES_IN=15m
ADMIN_REFRESH_TOKEN_EXPIRES_IN=7d
CHECK_USER_EMAIL={{CHECK_USER_EMAIL}}
GOOGLE_CLIENT_ID={{GOOGLE_OAUTH_CLIENT_ID}}
GOOGLE_CLIENT_SECRET={{GOOGLE_OAUTH_CLIENT_SECRET}}
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID={{GOOGLE_OAUTH_CLIENT_ID}}
NEXT_PUBLIC_ENABLE_GITHUB_AUTH=false
CRON_SECRET={{CRON_HEALTH_SECRET}}

# ----------------------------------------------------------------------------
# Firebase (Client + Admin)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY={{FIREBASE_API_KEY}}
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN={{FIREBASE_AUTH_DOMAIN}}
NEXT_PUBLIC_FIREBASE_PROJECT_ID={{FIREBASE_PROJECT_ID}}
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET={{FIREBASE_STORAGE_BUCKET}}
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID={{FIREBASE_MESSAGING_SENDER_ID}}
NEXT_PUBLIC_FIREBASE_APP_ID={{FIREBASE_APP_ID}}
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"{{FIREBASE_PROJECT_ID}}","private_key":"{{FIREBASE_PRIVATE_KEY}}","client_email":"{{FIREBASE_CLIENT_EMAIL}}"}'
FIREBASE_PRIVATE_KEY="{{FIREBASE_PRIVATE_KEY}}"
FIREBASE_CLIENT_EMAIL={{FIREBASE_CLIENT_EMAIL}}

# ----------------------------------------------------------------------------
# Payment Providers
# ----------------------------------------------------------------------------
ASAAS_ENV=sandbox
ASAAS_API_KEY_SANDBOX={{ASAAS_SANDBOX_KEY}}
ASAAS_API_KEY_PROD={{ASAAS_PRODUCTION_KEY}}
ASAAS_WEBHOOK_TOKEN={{ASAAS_WEBHOOK_TOKEN}}
STRIPE_SECRET_KEY={{STRIPE_SECRET_KEY}}
STRIPE_WEBHOOK_SECRET={{STRIPE_WEBHOOK_SECRET}}
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY={{STRIPE_PUBLISHABLE_KEY}}
NEXT_PUBLIC_STRIPE_BILLING_PORTAL_URL=https://billing.stripe.com/p/login/{{PORTAL_CODE}}
NEXT_PUBLIC_ASAAS_API_KEY={{ASAAS_PUBLIC_KEY}}
NEXT_PUBLIC_ASAAS_KEY={{ASAAS_PUBLIC_KEY}}
PAYMENT_LAST4=0000

# ----------------------------------------------------------------------------
# Messaging, Notifications & SendPulse
# ----------------------------------------------------------------------------
SENDPULSE_CLIENT_ID={{SENDPULSE_CLIENT_ID}}
SENDPULSE_CLIENT_SECRET={{SENDPULSE_CLIENT_SECRET}}
SENDPULSE_APP_ID={{SENDPULSE_APP_ID}}
SENDPULSE_APP_SECRET={{SENDPULSE_APP_SECRET}}
SENDPULSE_BOT_ID={{SENDPULSE_BOT_ID}}
SENDPULSE_ACCESS_TOKEN={{SENDPULSE_ACCESS_TOKEN}}
SENDPULSE_API_TOKEN={{SENDPULSE_API_TOKEN}}
SENDPULSE_WEBHOOK_SECRET={{SENDPULSE_WEBHOOK_SECRET}}
SENDPULSE_WEBHOOK_TOKEN={{SENDPULSE_WEBHOOK_TOKEN}}
MCP_SENDPULSE_URL=https://api.sendpulse.com
ALERT_EMAIL_RECIPIENTS={{ALERT_EMAILS}}
EMAIL_FROM="SV Lentes <contato@svlentes.com.br>"
NEXT_PUBLIC_EMAIL_FROM="SV Lentes <contato@svlentes.com.br>"
RESEND_API_KEY={{RESEND_API_KEY}}

# ----------------------------------------------------------------------------
# WhatsApp & Omni-channel Support
# ----------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN={{WHATSAPP_ACCESS_TOKEN}}
WHATSAPP_APP_SECRET={{WHATSAPP_APP_SECRET}}
WHATSAPP_API_VERSION=v20.0
WHATSAPP_BUSINESS_NUMBER={{WHATSAPP_BUSINESS_NUMBER}}
WHATSAPP_PHONE_NUMBER_ID={{WHATSAPP_PHONE_NUMBER_ID}}
WHATSAPP_VERIFY_TOKEN={{WHATSAPP_VERIFY_TOKEN}}
WHATSAPP_WEBHOOK_VERIFY_TOKEN={{WHATSAPP_WEBHOOK_VERIFY_TOKEN}}
NEXT_PUBLIC_WHATSAPP_NUMBER=5533999898026
NEXT_PUBLIC_SUPPORT_PHONE=5533999898026

# ----------------------------------------------------------------------------
# Sanity CMS
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID={{SANITY_PROJECT_ID}}
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-10-24
SANITY_API_TOKEN={{SANITY_API_TOKEN}}
SANITY_WRITE_TOKEN={{SANITY_WRITE_TOKEN}}

# ----------------------------------------------------------------------------
# Personalização, Analytics e Feature Flags
# ----------------------------------------------------------------------------
PERSONALIZATION_ENABLED=true
PERSONALIZATION_DEBUG=false
PERSONALIZATION_CACHE_TTL=3600
PERSONALIZATION_EDGE_RUNTIME=true
PERSONALIZATION_ANALYTICS_ENABLED=true
BEHAVIOR_TRACKING_ENABLED=true
BEHAVIOR_DATA_RETENTION_DAYS=90
CONSENT_REQUIRED=true
AB_TESTING_ENABLED=true
AB_TESTING_TRAFFIC_ALLOCATION=100
DEFAULT_PLAN_TYPE=padrao
NEXT_PUBLIC_AUTH_CACHE_KEY={{PUBLIC_AUTH_CACHE_KEY}}

# ----------------------------------------------------------------------------
# Observabilidade & Segurança
# ----------------------------------------------------------------------------
SENTRY_DSN={{SENTRY_DSN}}
SENTRY_AUTH_TOKEN={{SENTRY_AUTH_TOKEN}}
NEXT_PUBLIC_SENTRY_DSN={{SENTRY_DSN}}
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY={{LANGCHAIN_API_KEY}}
LANGCHAIN_PROJECT=svlentes-whatsapp-support
OPENAI_API_KEY={{OPENAI_API_KEY}}
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
DATADOG_API_KEY={{DATADOG_API_KEY}}
AWS_REGION={{AWS_REGION}}
AWS_ACCESS_KEY_ID={{AWS_ACCESS_KEY_ID}}
AWS_SECRET_ACCESS_KEY={{AWS_SECRET_ACCESS_KEY}}
AWS_S3_BUCKET={{AWS_S3_BUCKET}}
AWS_CLOUDWATCH_LOG_GROUP=/svlentes/app
MONITORING_WEBHOOK_URL={{MONITORING_WEBHOOK_URL}}
DEBUG_LEVEL=info
REDACT_SENSITIVE=true

# ----------------------------------------------------------------------------
# CDN & Asset Delivery
# ----------------------------------------------------------------------------
CDN_DOMAIN=cdn.svlentes.com.br
CONTENT_CACHE_MAX_AGE=300
DEFAULT_LOCALE=pt-BR
SUPPORTED_LOCALES=pt-BR,en-US,es-ES

# ----------------------------------------------------------------------------
# Default Address & Contact (used for fallbacks in tests)
# ----------------------------------------------------------------------------
DEFAULT_STREET=Rua Exemplo
DEFAULT_NUMBER=100
DEFAULT_NEIGHBORHOOD=Centro
DEFAULT_CITY=Sao Paulo
DEFAULT_STATE=SP
DEFAULT_ZIPCODE=01000-000
DEFAULT_PHONE=5531999999999
DEFAULT_MONTHLY_VALUE=149.90

# ----------------------------------------------------------------------------
# Testing & Tooling
# ----------------------------------------------------------------------------
CI=false
DEBUG_TESTS=false
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=Test123!@#
TEST_USER_UID={{TEST_USER_UID}}
TEST_USER_2_EMAIL=second@example.com
TEST_USER_2_UID={{TEST_USER_2_UID}}
TEST_CONTACT_ID={{SENDPULSE_CONTACT_ID}}
TEST_PHONE=5531999999999
STRIPE_TEST_CUSTOMER_1={{STRIPE_CUSTOMER_ID}}
STRIPE_TEST_CUSTOMER_2={{STRIPE_CUSTOMER_ID_2}}
STRIPE_TEST_SUBSCRIPTION_1={{STRIPE_SUBSCRIPTION_ID}}
STRIPE_TEST_SUBSCRIPTION_2={{STRIPE_SUBSCRIPTION_ID_2}}
FORCE_PRODUCTION_SCRIPT=false
VAR_NAME=

# ----------------------------------------------------------------------------
# Miscellaneous Flags
# ----------------------------------------------------------------------------
BASE_URL_EXTERNAL=https://svlentes.com.br
GOOGLE_VERIFICATION_CODE={{GOOGLE_SITE_VERIFICATION}}
NEXT_PUBLIC_GA_ID={{GA_ID}}
NEXT_PUBLIC_GA_MEASUREMENT_ID={{GA_MEASUREMENT_ID}}
