{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "es6"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/components/*": [
        "./src/components/*"
      ],
      "@/lib/*": [
        "./src/lib/*"
      ],
      "@/types/*": [
        "./src/types/*"
      ],
      "@/data/*": [
        "./src/data/*"
      ],
      "@/vision/*": [
        "./src/vision/*"
      ],
      "@/vision-components/*": [
        "./src/vision/components/*"
      ],
      "@/vision-hooks/*": [
        "./src/vision/hooks/*"
      ],
      "@/vision-services/*": [
        "./src/vision/services/*"
      ],
      "@/vision-types/*": [
        "./src/vision/types/*"
      ],
      "@/vision-utils/*": [
        "./src/vision/utils/*"
      ]
    },
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "prisma/seed-*.ts",
    "scripts/**/*.ts"
  ]
}
