  PROMOTION
  UPDATE
  ALERT
}

enum InteractionType {
  SENT
  DELIVERED
  OPENED
  CLICKED
  DISMISSED
  OPTED_OUT
  CONVERTED
}

// ==================== LGPD COMPLIANCE ENUMS ====================

enum ConsentType {
  TERMS
  DATA_PROCESSING
  MARKETING
  MEDICAL_DATA
}

enum ConsentStatus {
  GRANTED
  REVOKED
  EXPIRED
}

enum DataRequestType {
