# Rate limiting & security
BLOCKED_IPS=203.0.113.0/24,198.51.100.0/24
NEXT_PUBLIC_WS_URL=https://ws.svlentes.com.br

# Test fallbacks (keep but rotate frequently)
TEST_USER_EMAIL=qa-automation@svlentes.com.br
TEST_USER_PASSWORD={{TEST_USER_PASSWORD}}
TEST_USER_UID={{TEST_USER_UID}}
TEST_USER_2_EMAIL=qa-automation-2@svlentes.com.br
TEST_USER_2_UID={{TEST_USER_2_UID}}
TEST_CONTACT_ID={{TEST_CONTACT_ID}}
TEST_PHONE={{TEST_PHONE}}

# Stripe QA fixtures (optional for smoke tests)
STRIPE_TEST_CUSTOMER_1={{STRIPE_TEST_CUSTOMER_1}}
STRIPE_TEST_CUSTOMER_2={{STRIPE_TEST_CUSTOMER_2}}
STRIPE_TEST_SUBSCRIPTION_1={{STRIPE_TEST_SUBSCRIPTION_1}}
STRIPE_TEST_SUBSCRIPTION_2={{STRIPE_TEST_SUBSCRIPTION_2}}

# Feature toggles
AB_TESTING_ENABLED=true
AB_TESTING_TRAFFIC_ALLOCATION=100
PERSONALIZATION_ANALYTICS_ENABLED=true

# External webhooks & support integrations
NEXT_PUBLIC_ASAAS_KEY={{ASAAS_PUBLIC_KEY}}
MCP_SENDPULSE_URL=https://api.sendpulse.com
MONITORING_WEBHOOK_URL={{MONITORING_WEBHOOK_URL}}
SLACK_WEBHOOK_URL={{SLACK_WEBHOOK_URL}}

